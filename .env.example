# Copy to .env — or better, run: bash scripts/setup.sh
# NEVER commit .env. NEVER paste a token into the Claude chat window.

# Required. Needs: ads_read, ads_management, business_management,
# pages_read_engagement, pages_show_list.  See README.md §2.
META_ACCESS_TOKEN=

# Optional defaults. Any spec can override these per campaign or per ad.
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_IG_USER_ID=
META_PIXEL_ID=

META_API_VERSION=v23.0

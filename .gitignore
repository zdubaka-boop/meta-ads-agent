# Credentials — never commit
.env
.env.*
!.env.example

# Run state, created object IDs, audit exports, account data
outputs/*
!outputs/.gitkeep
*-state.json

# Creative assets
creatives/*
!creatives/.gitkeep
*.mp4
*.mov
*.jpg
*.jpeg
*.png

# Campaign specs carry real ad account IDs, Page IDs, landing pages and ad
# copy. Never commit them — the example lives in spec/examples/ instead.
specs/*
!specs/.gitkeep

__pycache__/
*.pyc
.DS_Store
.venv/

# Vercel
.vercel
.env*
